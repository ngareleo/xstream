{
  "name": "xstream",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server-rust",
    "scripts"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:plain": "bun scripts/dev-plain.ts",
    "design": "bun scripts/design.ts",
    "build": "bun run --filter client build",
    "lint": "bun run --filter '*' lint",
    "format": "prettier --write \"**/*.{ts,tsx,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\" --ignore-path .prettierignore",
    "stop": "bash scripts/stop.sh",
    "setup:dev": "bun scripts/setup-dev.ts",
    "setup-ffmpeg": "bun scripts/setup-ffmpeg.ts",
    "schema:emit": "cargo run --quiet --bin print_schema -p xstream-server --features dev-features > server-rust/schema.graphql",
    "tauri:dev": "bun scripts/tauri-dev.ts",
    "tauri:build": "bun scripts/tauri-build.ts",
    "tauri:build:dev": "bun scripts/tauri-build-dev.ts",
    "clean": "bash scripts/clean.sh",
    "clean:db": "bash scripts/clean.sh --db",
    "seq:start": "bun scripts/seq-start.ts",
    "seq:stop": "bun scripts/seq-stop.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.29.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-tsconfig-paths": "^1.0.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "graphql": "^16.13.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "typescript-eslint": "^8.58.1"
  },
  "lint-staged": {
    "client/src/**/*.{ts,tsx}": [
      "eslint --fix --config client/eslint.config.js",
      "prettier --write"
    ],
    "**/*.{json,yaml,yml}": [
      "prettier --write"
    ]
  }
}
